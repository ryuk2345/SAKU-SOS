# ==========================================
# Configuración del Servidor Express
# ==========================================
PORT=3000

# ==========================================
# Gupshup WhatsApp API (proveedor activo)
# ==========================================
# API Key de la app en Gupshup (Configuración > API Keys)
GUPSHUP_API_KEY=tu_gupshup_api_key_aqui

# Nombre de la app en Gupshup (ej. SakuSOS)
GUPSHUP_APP_NAME=tu_app_name_aqui

# Número de WhatsApp registrado en Gupshup, solo dígitos (ej. 51984424719)
GUPSHUP_SOURCE_NUMBER=tu_numero_aqui

# App ID de Gupshup (opcional, solo referencia)
GUPSHUP_APP_ID=tu_app_id_aqui

# ==========================================
# Twilio WhatsApp API (Opcional / Legado)
# ==========================================
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ==========================================
# Meta / WhatsApp Cloud API (Opcional / Legado)
# ==========================================
# META_VERIFY_TOKEN=tu_token_de_verificacion_aqui
# WHATSAPP_API_TOKEN=tu_whatsapp_access_token_aqui
# WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id_aqui

# ==========================================
# Gemini (Google AI Studio) - motor conversacional activo
# ==========================================
# Gratis, sin tarjeta: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Modelo para el clasificador de riesgo (Paso 3a)
GEMINI_RISK_MODEL=gemini-2.5-flash

# Modelo conversacional para apoyo emocional (Paso 3c)
GEMINI_CHAT_MODEL=gemini-2.5-flash

# ==========================================
# Anthropic / Claude (Opcional / Legado - no se usa mientras se use Gemini)
# ==========================================
# ANTHROPIC_API_KEY=tu_anthropic_api_key_aqui
CLAUDE_RISK_MODEL=claude-3-5-haiku-20241022
CLAUDE_CHAT_MODEL=claude-3-5-sonnet-20241022

# ==========================================
# PostgreSQL
# ==========================================
# Puedes definir DATABASE_URL o las credenciales individuales
DATABASE_URL=postgresql://usuario:password@localhost:5432/whatsapp_bot
# PGHOST=localhost
# PGPORT=5432
# PGUSER=usuario
# PGPASSWORD=password
# PGDATABASE=whatsapp_bot

# ==========================================
# Redis (BullMQ)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# O URL completa si usas un servicio cloud:
# REDIS_URL=redis://:password@localhost:6379
