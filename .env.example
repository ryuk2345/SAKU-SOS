# ==========================================
# Configuración del Servidor Express
# ==========================================
PORT=3000

# ==========================================
# Twilio WhatsApp API
# ==========================================
# Account SID de Twilio (empieza con AC...)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Auth Token de Twilio (usado para autenticar llamadas y verificar X-Twilio-Signature)
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Número de WhatsApp de Twilio (formato whatsapp:+14155238886)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ==========================================
# Meta / WhatsApp Cloud API (Opcional / Legado)
# ==========================================
# META_VERIFY_TOKEN=tu_token_de_verificacion_aqui
# WHATSAPP_API_TOKEN=tu_whatsapp_access_token_aqui
# WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id_aqui

# ==========================================
# Anthropic / Claude
# ==========================================
ANTHROPIC_API_KEY=tu_anthropic_api_key_aqui

# Modelo para el clasificador de riesgo (Paso 3a) - Por defecto Claude 3.5 Haiku
CLAUDE_RISK_MODEL=claude-3-5-haiku-20241022

# Modelo conversacional para apoyo emocional (Paso 3c) - Configurable (ej. Claude 3.5 Sonnet)
CLAUDE_CHAT_MODEL=claude-3-5-sonnet-20241022

# ==========================================
# PostgreSQL
# ==========================================
# Puedes definir DATABASE_URL o las credenciales individuales
DATABASE_URL=postgresql://usuario:password@localhost:5432/whatsapp_bot
# PGHOST=localhost
# PGPORT=5432
# PGUSER=usuario
# PGPASSWORD=password
# PGDATABASE=whatsapp_bot

# ==========================================
# Redis (BullMQ)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# O URL completa si usas un servicio cloud:
# REDIS_URL=redis://:password@localhost:6379
